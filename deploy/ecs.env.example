# Copy to .env on ECS and fill your application's credentials locally.
DATA_MODE=live
CHECKIN_MODE=mock
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://girtrobotlab.feishu.cn/base/IPtmbKzAlalpS1sHv4Wc5YvhnHg?from=from_copylink
DEADLINE_MODE=date
PORT=3001
# Optional only when several tables match the schema.
FEISHU_TASKS_TABLE_ID=
FEISHU_MEMBERS_TABLE_ID=
# Set both when enabling HTTP Basic behind HTTPS.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Daily report (server only; Beijing time). Enable after setting the group Webhook.
REPORT_ENABLED=false
REPORT_SEND_TIME=22:00
REPORT_DB_PATH=data/reports.sqlite
FEISHU_WEBHOOK_URL=
FEISHU_BOT_SECRET=
ADMIN_REPORT_TOKEN=
HOST=127.0.0.1

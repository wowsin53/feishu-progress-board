[Unit]
Description=fs RoboMaster Mission Control and Daily Reports
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=fs
Group=fs
WorkingDirectory=/opt/fs/current
Environment=NODE_ENV=production
EnvironmentFile=/opt/fs/shared/.env
ExecStart=/opt/fs/runtime/bin/node /opt/fs/current/dist-server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fs/data /opt/fs/logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fs
[Install]
WantedBy=multi-user.target

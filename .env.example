# Server only. Configure app credentials once, then supply a Base link.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=
# Optional legacy token and table overrides. IDs are not needed for a unique matching schema.
FEISHU_BASE_TOKEN=
FEISHU_MEMBERS_TABLE_ID=
FEISHU_TASKS_TABLE_ID=
FEISHU_CHECKINS_TABLE_ID=
# auto | mock | live. Partial configuration is an error, never a silent fallback.
DATA_MODE=auto
CHECKIN_MODE=mock
PORT=3001
# date: deadline is end of China calendar day; datetime: exact field timestamp.
DEADLINE_MODE=date
# Exact permitted frontend origin when API is hosted separately.
ALLOWED_ORIGIN=
# Optional HTTP Basic protection for API AND Linux static frontend.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Public settings only. Never put a secret in a VITE_ variable.
VITE_API_BASE_URL=
VITE_STATIC_MOCK=false
VITE_BASE_PATH=./

# Daily report (server only; Beijing time). Enable after setting the group Webhook.
REPORT_ENABLED=false
REPORT_SEND_TIME=00:30
REPORT_DB_PATH=data/reports.sqlite
FEISHU_WEBHOOK_URL=
FEISHU_BOT_SECRET=
ADMIN_REPORT_TOKEN=
HOST=127.0.0.1

# Optional ISO timestamp: do not catch up before the first intended send.
REPORT_START_AT=

# Optional directory-verified personnel groups by stable ID (server only).
FEISHU_MEMBER_GROUPS_JSON={}

# New task audit: local dry-run only; explicitly set activation timestamp with timezone.
# DeepSeek URL/model/key and semantic rejection threshold require configuration.
DRY_RUN=true
REVIEW_ENABLED_AT=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_CANDIDATES=20
AI_REJECT_CONFIDENCE=
